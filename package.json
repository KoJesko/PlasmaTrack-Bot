{
  "name": "plasmatrack-bot",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/core",
    "packages/worker",
    "packages/renderer"
  ],
  "scripts": {
    "license-audit": "node scripts/license-audit.mjs",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "check": "npm run secret-scan && npm run license-audit && npm run typecheck && npm test",
    "secret-scan": "node scripts/secret-scan.mjs",
    "sync-contract": "node scripts/sync-contract.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@maplibre/maplibre-gl-native@6.4.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true
  }
}
