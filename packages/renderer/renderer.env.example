# PlasmaTrack renderer configuration. Copy to renderer.env (git-ignored) and fill in.
# `npm start -w @plasmatrack/renderer` loads renderer.env if it exists; real
# environment variables take precedence.

# Shared HMAC key: must equal the Worker's RENDERER_KEY secret. At least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RENDERER_KEY=

# Where to listen. Keep 127.0.0.1 behind a reverse proxy that terminates TLS;
# use 0.0.0.0 only if something else restricts who can connect.
RENDERER_HOST=127.0.0.1
RENDERER_PORT=8788

# Basemap archives generated with truckermudgeon/maps (see docs/TILES.md).
# Leave one empty to draw that game's routes on a blank background.
TILES_ETS2=/srv/plasmatrack/tiles/ets2.pmtiles
TILES_ATS=/srv/plasmatrack/tiles/ats.pmtiles

# Basemap features whose property is true are removed before drawing.
STRIP_FLAGS=hidden,secret

# Parallel renders, and how many may wait before callers get 503 + Retry-After.
RENDER_CONCURRENCY=2
RENDER_QUEUE_LIMIT=16
