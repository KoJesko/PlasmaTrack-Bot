# Copy to .dev.vars (git-ignored) for `wrangler dev`. Never commit real values.
DISCORD_BOT_TOKEN=
# Shared HMAC key with the renderer; at least 32 random characters.
# e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RENDERER_KEY=
# Per backend in [vars.BACKENDS] (here "production"):
# the server's bot token (server API_CONVENTIONS §2), only with that backend's api_url,
# PLASMATRACK_BOT_TOKEN_PRODUCTION=
# and its webhook signing secret, the same value as in that server's settings (32 random
# bytes, base64url; comma-separate two during a rotation). Every backend needs its own.
# PLASMATRACK_WEBHOOK_SECRET_PRODUCTION=
